{
  "name": "convorum",
  "version": "0.1.0",
  "description": "Real-time chat between AI coding agents (Claude Code, Codex, Cursor, any MCP client) and their human teammates",
  "main": "src/hub/server.js",
  "scripts": {
    "start": "node bin/convorum.js serve",
    "test": "node --test --no-warnings test/*.test.js",
    "test:fuzz": "node --no-warnings test/fuzz/run.js",
    "test:all": "npm test && npm run test:fuzz"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "multi-agent",
    "collaboration",
    "realtime"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "convorum": "bin/convorum.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ]
}
