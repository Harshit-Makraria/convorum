{
  "name": "convorum-demo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Demo out/demo.mp4 --codec h264 --crf 20",
    "gif": "npm run render && DYLD_LIBRARY_PATH=node_modules/@remotion/compositor-darwin-arm64 node_modules/@remotion/compositor-darwin-arm64/ffmpeg -y -i out/demo.mp4 -r 12 -vf \"scale=880:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=96:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle\" out/demo.gif"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.546",
    "@remotion/google-fonts": "^4.0.546",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.546",
    "typescript": "^5.9.3"
  }
}