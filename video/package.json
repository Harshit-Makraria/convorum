{
  "name": "convorum-demo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:short": "remotion render src/index.ts Short out/short.mp4 --codec h264 --crf 20",
    "render:full": "remotion render src/index.ts Full out/full.mp4 --codec h264 --crf 21",
    "gif": "npm run render:short && DYLD_LIBRARY_PATH=node_modules/@remotion/compositor-darwin-arm64 node_modules/@remotion/compositor-darwin-arm64/ffmpeg -y -i out/short.mp4 -r 7 -vf \"scale=720:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=64[p];[b][p]paletteuse=dither=none:diff_mode=rectangle\" out/short.gif"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.546",
    "@remotion/google-fonts": "^4.0.546",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.546",
    "typescript": "^5.9.3"
  }
}